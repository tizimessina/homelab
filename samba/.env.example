# Copiar a .env y completar
TZ=America/Argentina/Buenos_Aires

# Usuario de Samba: tiene que coincidir con un usuario real del host (mismo nombre y UID)
SAMBA_USER=usuario

# Hash generado con:
#   docker run -it --rm ghcr.io/servercontainers/samba:latest create-hash.sh
SAMBA_PASSWORD_HASH=pegar-el-hash-completo-aca
